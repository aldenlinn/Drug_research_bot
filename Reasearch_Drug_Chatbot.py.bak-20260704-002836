from __future__ import annotations

import os
import sys

# Serving is launched from the Drug_research_bot repo root, which contains a from-source
# `bitsandbytes/` checkout. That directory shadows the installed package as a hollow namespace
# (no `.nn`), so when PEFT attaches the LoRA adapter it calls is_bnb_4bit_available() ->
# `bnb.nn.Linear4bit` and dies with AttributeError, even though this serve is pure bf16. Pre-import
# the REAL bitsandbytes with the shadow entries temporarily off sys.path so it caches in sys.modules,
# then restore sys.path so the local modules (rag_retriever, drugbot_prompts, ie_client) still import.
# Once cached, the later `import bitsandbytes` inside transformers/peft returns the real module.
_HERE = os.path.dirname(os.path.abspath(__file__))
_saved_sys_path = sys.path[:]
sys.path[:] = [p for p in sys.path if p not in ("", ".", os.getcwd(), _HERE)]
try:
    import bitsandbytes  # noqa: F401 -- resolve to the real install and cache it before peft imports it
except Exception:  # noqa: BLE001 -- if bnb is genuinely absent, peft will surface it at adapter time
    pass
finally:
    sys.path[:] = _saved_sys_path

